[settings]
# Xcode 26.4 and newer ship apple-clang 21; the compiler itself comes from
# xcode-select, since /usr/bin/clang++ follows the selected Xcode. armv8 is
# Apple silicon; an Intel Mac needs arch=x86_64.
os=Macos
arch=armv8
build_type=Release
compiler=apple-clang
compiler.cppstd=23
compiler.version=21
compiler.libcxx=libc++
